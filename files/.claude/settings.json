{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "WebFetch",
      "Grep",
      "Glob",
      "LS",
      "NotebookRead",
      "TodoRead"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git branch -D*)",
      "Bash(git rebase*)",
      "Bash(git filter-branch*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git reflog expire*)",
      "Bash(git gc --prune*)",
      "Bash(rm*)",
      "Bash(npm publish*)",
      "Bash(yarn publish*)",
      "Bash(pnpm publish*)",
      "Bash(vercel deploy*)",
      "Bash(vercel --prod*)",
      "Bash(netlify deploy*)",
      "Bash(fly deploy*)",
      "Bash(heroku *)",
      "Bash(kubectl apply*)",
      "Bash(terraform apply*)",
      "Bash(cdk deploy*)",
      "Bash(serverless deploy*)",
      "Bash(docker push*)",
      "Bash(gcloud app deploy*)",
      "Bash(gcloud deploy*)",
      "Bash(prisma *)",
      "Bash(npx prisma *)",
      "Bash(pnpm prisma *)",
      "Bash(yarn prisma *)",
      "Bash(npm run prisma*)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Read(**/journal/**)",
      "Edit(**/.env*)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/secrets/**)",
      "Edit(**/.aws/**)",
      "Edit(**/.ssh/**)",
      "Bash(*.env*)",
      "Bash(*.ssh*)",
      "Bash(*.aws*)",
      "Bash(*.pem*)",
      "Bash(*id_rsa*)",
      "Bash(*id_ed25519*)",
      "Bash(*secrets/*)"
    ]
  },
  "model": "sonnet",
  "disableClaudeAiConnectors": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true
  },
  "effortLevel": "medium",
  "theme": "auto"
}
